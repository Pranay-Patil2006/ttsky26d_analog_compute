# Top-level assembly of tt_um_ttsky26d_analog_compute (1.8V tt_analog_2x2.def, 334.88 x 225.76 um).
# Run from mag/:  magic -dnull -noconsole -rcfile $PDK_ROOT/sky130A/libs.tech/magic/sky130A.magicrc build_top.tcl
# Block layouts come from ../layout/blocks/<cell>/out (generated by gen.py); placement per layout/FLOORPLAN.md.
set TOP tt_um_ttsky26d_analog_compute
drc off
snap internal
foreach c {combined idac_universal} { addpath ../layout/blocks/$c/out }

def read tt_analog_2x2.def
cellname rename tt_um_template $TOP
load $TOP
tech unlock *

proc stripe {name x} {
    box ${x}um 5um [expr {$x+2}]um 220.76um
    paint met4
    label $name FreeSans 0.25u -met4
    port make
    port use [expr {$name eq "VGND" ? "ground" : "power"}]
    port class bidirectional
    port connections n s e w
}
stripe VDPWR 1
stripe VGND  4

# analog pins ua[0..5]: met4 stub from the pin into the die (analog_pins: 6)
foreach x {152.26 132.94 113.62 94.30 74.98 55.66} {
    box [expr {$x-0.45}]um 0um [expr {$x+0.45}]um 5um
    paint met4
}

# place a cell so that its bounding box lower-left lands at (x,y) um
proc place {cell inst x y} {
    box 0 0 0 0
    getcell $cell
    identify $inst
    select cell $inst
    move to ${x}um ${y}um
}
# lower-left targets (um) from FLOORPLAN.md
place combined       x_core   8.0   3.0
place idac_universal x_idac_c 8.0   158.0
place idac_universal x_idac_b 90.0  158.0
place idac_universal x_idac_a 172.0 158.0

select top cell
save $TOP.mag
drc on
drc check
drc catchup
puts "DRC_COUNT: [drc listall count total]"
gds write ../gds/${TOP}.gds
lef write ../lef/${TOP}.lef -hide -pinonly
quit -noprompt
